# Copy this file to .env and fill in real values.
# app/core/config.py loads these; every field has a safe default except
# AI_API_KEY, which the AI step needs to do anything useful.

# Required for real AI generation. See docs/AI_SERVICE.md for free-tier
# options (Groq, Gemini, OpenRouter) if you don't have an OpenAI key --
# or run `python scripts/dev_server_with_fake_ai.py` instead of uvicorn
# to skip needing a key entirely during local development.
AI_API_KEY=

# Defaults to gpt-4o-mini if left blank. Set this to match whichever
# provider/model AI_BASE_URL points at, e.g. llama-3.3-70b-versatile
# for Groq.
AI_MODEL=

# Leave blank to use OpenAI's real API. Set this to use an
# OpenAI-compatible free-tier provider instead -- see docs/AI_SERVICE.md.
AI_BASE_URL=

# Must exactly match the origin the frontend is served from -- CORS
# treats http://localhost:5173 and http://127.0.0.1:5173 as different
# origins even though they're the same machine to a person. See
# docs/PHASE8_INTEGRATION.md's CORS section if requests are mysteriously
# failing in the browser but succeeding via curl.
FRONTEND_ORIGIN=http://localhost:5173

# Code execution is disabled by default -- see docs/CODE_EXECUTION_SECURITY.md
# for why this is a deliberate, explicit opt-in rather than auto-detected.
# Requires Docker to actually be installed and reachable; see
# docs/DEPLOYMENT.md. Leaving this false (or Docker unavailable) degrades
# to an honest "unsupported" execution result rather than failing.
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_TIMEOUT_SECONDS=5

MAX_UPLOAD_SIZE_MB=10
ENVIRONMENT=development
