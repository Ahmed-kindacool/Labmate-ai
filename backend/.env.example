# Copy this file to .env and fill in real values.
# app/core/config.py loads these; every field has a safe default except
# AI_API_KEY, which the AI step needs to do anything useful.

# Required for real AI generation. See docs/AI_SERVICE.md for free-tier
# options (Groq, Gemini, OpenRouter) if you don't have an OpenAI key --
# or run `python scripts/dev_server_with_fake_ai.py` instead of uvicorn
# to skip needing a key entirely during local development.
AI_API_KEY=

# Defaults to gpt-4o-mini if left blank. Set this to match whichever
# provider/model AI_BASE_URL points at, e.g. llama-3.3-70b-versatile
# for Groq.
AI_MODEL=

# Leave blank to use OpenAI's real API. Set this to use an
# OpenAI-compatible free-tier provider instead -- see docs/AI_SERVICE.md.
AI_BASE_URL=

# Browser origin(s) allowed to call the API -- comma-separated. Only needed when
# the frontend is served from a DIFFERENT origin than the backend (local dev).
# In the Docker image the backend serves the UI itself and this is irrelevant.
# http://localhost:5173 and http://127.0.0.1:5173 are different origins.
FRONTEND_ORIGIN=http://localhost:5173

# Directory holding the built frontend (frontend/dist). When set, the backend
# serves the UI itself (same origin: no CORS, no API URL to configure).
FRONTEND_DIST_DIR=

# ---- Code execution (what makes the report contain REAL output) ----------
# Off by default. Turn it on only where the code is allowed to run:
CODE_EXECUTION_ENABLED=false
#   docker -> one throwaway container per run (needs docker CLI + daemon)
#   local  -> locked-down child process inside THIS server's container
#             (use this on Render/Railway/Fly/your own Dockerfile). Runs as
#             an unprivileged user when the server is root. See docs/DEPLOYMENT.md
CODE_EXECUTION_MODE=docker
CODE_EXECUTION_TIMEOUT_SECONDS=10
CODE_COMPILE_TIMEOUT_SECONDS=30

# AI request timeout / automatic retries for transient errors
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# Output budget per request. Reasoning models (openai/gpt-oss-*) spend hidden
# "thinking" tokens from THIS budget; too small => empty answer. A lab with
# several source files needs ~8-10k. If your provider's free tier has a small
# per-minute token limit, a big lab may still be rejected (413/429).
AI_MAX_OUTPUT_TOKENS=12000
# Blank = automatic (low for gpt-oss models, not sent otherwise). low|medium|high
AI_REASONING_EFFORT=

MAX_UPLOAD_SIZE_MB=10
ENVIRONMENT=development
